def is_muted(user_id):
    if str(user_id) in muted_users:
        mute_time = datetime.fromisoformat(muted_users[str(user_id)])
        if mute_time > datetime.now():
            return True
        else:
            del muted_users[str(user_id)]
            save_all()
    return False

